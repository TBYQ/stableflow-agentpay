# Flare Coston2 RPC.
# Official public RPC: https://coston2-api.flare.network/ext/C/rpc
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Private key for a Coston2-funded test wallet.
# Never commit a real private key. Keep it only in contracts/.env.
COSTON2_PRIVATE_KEY=

# Optional: used by scripts/record-demo-payment.js.
STABLEFLOW_PAYMENT_CONTRACT=
STABLEFLOW_PAYMENT_INTENT_ID=pi_001
STABLEFLOW_SERVICE_ID=premium-market-report
STABLEFLOW_PAYMENT_AMOUNT=0.001

# Optional: defaults to the deployment wallet. Native C2FLR and FXRP payments
# are forwarded to this merchant address in the same transaction.
STABLEFLOW_SETTLEMENT_RECIPIENT=

# FDC-XRP proof workflow. The verifier and DA layer credentials are needed only
# when submitting and retrieving a real FDC attestation, never by the web app.
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network/verifier
FDC_VERIFIER_API_KEY=00000000-0000-0000-0000-000000000000
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network
COSTON2_DA_LAYER_API_KEY=
STABLEFLOW_FDC_PROOF_CONTRACT=
