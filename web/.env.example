# Leave blank when the Go service hosts the built checkout (public deployment).
# Use http://127.0.0.1:8080 only for a separate local Vite frontend.
VITE_API_BASE_URL=

# Deployed StableFlowPayment contract on Flare Coston2.
# The UI can create payment intents without this, but cannot submit MetaMask payments.
VITE_STABLEFLOW_PAYMENT_CONTRACT=0x895F16cD2d140cA8C02674A3902C5e4f821932D4
